{
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  },
  "private": true,
  "scripts": {
    "lint": "bun run lint:css && bun run lint:js && hugo --gc --minify --cleanDestinationDir --panicOnWarning --printPathWarnings",
    "lint:css": "stylelint \"themes/hugo-wishingwell-theme/assets/css/**/*.css\"",
    "lint:js": "biome lint themes/hugo-wishingwell-theme/assets/js/",
    "lint:fix": "stylelint --fix \"themes/hugo-wishingwell-theme/assets/css/**/*.css\" && biome check --write themes/hugo-wishingwell-theme/assets/js/"
  },
  "type": "module"
}
